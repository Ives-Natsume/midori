{
  "name": "cw",
  "version": "0.1.0",
  "protocol": 2,
  "command": ["midori-plugin-cw"],
  "input": {
    "type": "audio",
    "sample_rate_hz": 48000,
    "channels": 1
  },
  "outputs": ["display", "packets"],
  "demod_modes": ["cw"],
  "params": [
    {
      "name": "tone_hz",
      "kind": "float",
      "default": 700.0,
      "min": 100.0,
      "max": 3000.0,
      "description": "Beat-frequency tone the decoder listens on, Hz."
    },
    {
      "name": "envelope_hz",
      "kind": "float",
      "default": 50.0,
      "min": 10.0,
      "max": 500.0,
      "description": "Keying-envelope detector bandwidth, Hz."
    },
    {
      "name": "start_at_signal",
      "kind": "bool",
      "default": false,
      "description": "Skip the leading-silence gate and start decoding immediately."
    }
  ]
}
